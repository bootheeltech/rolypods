{
  "name": "rolypods",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/flatten-rsc.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json",
    "pages:dev": "wrangler pages dev out --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply rolypods --local",
    "db:migrate:remote": "wrangler d1 migrations apply rolypods --remote"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.162.0"
  }
}
